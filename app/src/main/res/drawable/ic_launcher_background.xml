<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background for the valkyria launcher icon.
  Solid white: the foreground layer (ic_launcher_foreground.png) is an
  orange disc with a valkyria-shaped *transparent cutout*, so the
  cutout reveals the background. White here is what makes the figure
  silhouette visible inside the orange disc and also fills the corners
  on launchers that mask to a squircle/rounded-square wider than the
  inscribed circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0h108v108h-108z" />
</vector>
