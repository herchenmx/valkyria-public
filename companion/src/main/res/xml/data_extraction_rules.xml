<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (API 31+) for the companion app. Excludes the Hevy
    auth prefs from cloud backup AND device transfer so tokens stay scoped to
    one install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hevy_auth.xml"/>
        <exclude domain="sharedpref" path="hevy_auth_enc.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hevy_auth.xml"/>
        <exclude domain="sharedpref" path="hevy_auth_enc.xml"/>
    </device-transfer>
</data-extraction-rules>
