<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Required on Android 13+ so the "New watch wants to sign in?" TOFU
         approval notification can actually surface. Ungranted just means the
         notification is silently skipped — the pending state is still kept in
         AuthPrefs so the user will see it next time they open the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!--
        Foreground-service permissions. The token-refresh worker promotes itself
        to a foreground service for the duration of doWork() so the OS Cached
        App Freezer (Android 12+) doesn't SIGSTOP the process mid-network-call.
        Without this promotion, every periodic refresh + every widget tap fired
        from a cached process surfaces as "UnknownHostException: No address
        associated with hostname" — the freezer tears down per-uid netd
        resolver state while the worker thread is suspended.

        DATA_SYNC is the Android 14+ FGS type for "periodic data synchronization
        over the network", which is exactly what this worker does.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <application
        android:name=".HevyCompanionApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".WebLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!--
            WearableListenerService: the Android Wearable framework starts this service
            automatically (even in the background) when it receives a message from the watch.
            Paths we handle: /request_auth, /watch_snapshot, /request_seed, /tokens_from_watch.

            The intent-filter narrows delivery to the exact paths we recognise so a
            misconfigured peer (or a hostile peer on a rooted phone) can't trigger
            the service for arbitrary unhandled paths. Wearable framework still
            enforces "delivered only by paired peers" at the transport level.
        -->
        <service
            android:name=".wear.WatchBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>
                <data android:scheme="wear" android:host="*" android:path="/request_auth"/>
                <data android:scheme="wear" android:host="*" android:path="/watch_snapshot"/>
                <data android:scheme="wear" android:host="*" android:path="/request_seed"/>
                <data android:scheme="wear" android:host="*" android:path="/tokens_from_watch"/>
            </intent-filter>
        </service>

        <!--
            Override WorkManager's SystemForegroundService entry to declare the
            foregroundServiceType. Required by Android 14+ FGS rules: the OS
            rejects setForeground() unless the hosting service has a matching
            type in its manifest entry. tools:node="merge" + tools:replace keeps
            the rest of WorkManager's declaration intact while we add the type.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- TOFU-approval broadcast receiver: handles the Trust / Reject actions
             on the "New watch wants to sign in?" notification. Not exported —
             only our own PendingIntents from the notification can trigger it. -->
        <receiver
            android:name=".wear.TrustWatchReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.hevycompanion.ACTION_TRUST_WATCH"/>
                <action android:name="com.example.hevycompanion.ACTION_REJECT_WATCH"/>
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: 3×1, shows token refresh + push timestamps with refresh button -->
        <receiver
            android:name=".TokenWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.example.hevycompanion.ACTION_WIDGET_REFRESH"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_token_status_info"/>
        </receiver>

        <!-- Shares the Strength Overview CSV export out of the cache dir via a
             content:// URI the receiving app can read. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>

</manifest>
