# Your personal Hevy API key, from Hevy's developer settings. Used as the
# X-Api-Key on the public REST API (api.hevyapp.com/v1).
HEVY_PUBLIC_API_KEY=your-hevy-public-api-key-here

# NOT a login credential and NOT per-user: this is the app-level X-Api-Key the
# official Hevy client sends on the private v2 API, extracted from its APK. It
# is sent *alongside* Authorization: Bearer <token>, and the bearer token is
# what actually authenticates you -- that comes from logging in through the
# companion's WebLoginActivity and is then pushed to the watch. Rotating this
# value does not log you out; it only matters if Hevy changes their client key.
HEVY_PRIVATE_API_KEY=your-hevy-private-api-key-here
# Fine-grained PAT used by the companion's HevyApiVersionSync to fetch
# api-versions/active.json from this (private) repo on cold start. Scope
# required: Contents → Read on this single repo only. Create at
# https://github.com/settings/personal-access-tokens/new — set Repository
# access to "Only select repositories" → pick this repo, then under
# "Repository permissions" set "Contents" to Read-only. Leave empty to
# disable the auto-sync (the SET_API_VERSION ADB broadcast on the watch is
# the manual fallback).
HEVY_API_VERSION_GITHUB_TOKEN=

# Debug webhook. When set, the watch and companion mirror every Hevy workout
# write — private v2 POST, public v1 POST/PUT, the resume DELETE, and the
# private workout GET that resume depends on — to this
# URL as JSON: method, path, HTTP status, timing, and the verbatim request and
# response BODIES. That makes a failed save readable from a phone browser
# instead of `adb logcat` at a desk, which is the point: the watch's release
# build is non-debuggable and awkward to attach to on the go.
#
# Set it in TWO places, for the two ways an APK gets built:
#   - here, for local ./gradlew assembleRelease builds
#   - as the Actions secret HEVY_DEBUG_WEBHOOK_URL, for the published APKs
#     that hevyinstallwatches / hevyinstallphone actually install
# It lives in secrets rather than in tracked config so a bin that goes dead can
# be swapped in GitHub's settings without a code change and a republish.
#
# https://webhook.cool and https://webhook.site both hand out a URL instantly.
#
# NO HEADERS ARE EVER SENT — not the Authorization: Bearer token, not
# X-Api-Key, not the public api-key. DebugWebhook.send() has no parameter that
# could carry one, a test pins the payload's field set, and
# /auth/refresh_token — whose body DOES carry a credential — is not matched.
#
# Workout bodies ARE sent, so this is your training data going to whoever
# operates that URL. Use one you control, and blank it when you're done
# debugging. Empty (the default) disables the feature entirely.
HEVY_DEBUG_WEBHOOK_URL=
